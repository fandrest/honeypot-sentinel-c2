# =============================================================================
# SENTINEL C2 - VARIABLES DE ENTORNO (PLANTILLA DE CONFIGURACIÓN)
# =============================================================================
# Copia este archivo como '.env' en las carpetas correspondientes o define estas
# variables en tu entorno del sistema operativo antes de arrancar los servicios.
# NUNCA subas tu archivo '.env' real a ningún repositorio público.
# =============================================================================

# --- Inteligencia Artificial y Análisis Forense (SentinelC2) ---
# Clave de API de Groq Cloud (obtener en https://console.groq.com)
GROQ_API_KEY=tu_groq_api_key_aqui

# --- Conexión a Base de Datos Central (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=honeypot_db
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql

# --- Módulo Monitor de Red (Node.js & Socket.IO) ---
# Puerto del servidor WebSocket para emisión de telemetría en tiempo real hacia SentinelC2
WS_PORT=3001

# --- Módulo Ataque Bots (Simulación de Botnet con Playwright) ---
# Base de datos donde los bots registran los accesos exitosos
BOTS_DB_NAME=bots_infiltradores
